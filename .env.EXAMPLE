# Secrets (set these in Vercel > Project > Settings > Environment Variables, never in the page)
# AI provider: fill in EITHER the Bedrock block OR ANTHROPIC_API_KEY (Bedrock is used if both are set)
# Claude through Amazon Bedrock (billed on your AWS account). Use these names, not AWS_ACCESS_KEY_ID.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
# Claude through Anthropic's own API
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random string used to sign login tokens (e.g. 40+ random characters). Never share it.
AUTH_SECRET=
# One single-use invite code per student, comma separated, e.g. amaka-4f9k,tunde-7q2m
INVITE_CODES=

# Limits (defaults shown; change to taste, then redeploy)
MODEL=claude-haiku-5-5
EFFORT=low
MAX_OUTPUT_TOKENS=1500
MAX_HISTORY_MESSAGES=8
MAX_INPUT_CHARS=24000
MONTHLY_TOKENS_PER_USER=900000
# DAILY_TOKENS_PER_USER=30000   (default: monthly / 30)
MAX_MSGS_PER_USER_MINUTE=6
DAILY_BUDGET_USD=3
MONTHLY_BUDGET_USD=30
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.50

# Plans and payments
TRIAL_DAYS=5
ULTRA_TOKENS_PER_USER=1800000
# Keep this secret. Lets you grant plans and read feedback at /admin.html
ADMIN_KEY=
# Shown to a student who taps Choose Pro / Choose Ultra. {user}, {plan}, {price} are filled in.
PAY_INSTRUCTIONS=Send {price} for {plan}, then message us on WhatsApp with your username: {user}. We activate your plan within a day.
# Optional: your payment provider's hosted payment links
CHECKOUT_URL_PRO=
CHECKOUT_URL_ULTRA=
